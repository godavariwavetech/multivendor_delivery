<?xml version="1.0" encoding="utf-8"?>
<!--
  The partner_app backend runs over plain HTTP on the development LAN
  (http://<pc>:2407), so the app has to be allowed to make cleartext requests.
  Android 7.0+ takes this file over the manifest's android:usesCleartextTraffic,
  which the React Native Gradle plugin pins to "false" for release builds.

  Remove this file, and its reference in AndroidManifest.xml, once the API is
  served over HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
